SECRET_KEY=replace-with-long-random-secret
COOKIE_SECURE=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-16-plus-character-password
ADMIN_BOOTSTRAP_TOKEN=replace-with-one-time-random-token
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
SAUDI_DATA_API_KEY=
RATE_LIMIT_STORAGE_URI=memory://
ENABLE_AUTO_SCAN=true
PORT=8080

# OpenAI Responses API — set the secret only in Northflank
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
OPENAI_REASONING_EFFORT=max
OPENAI_MAX_OUTPUT_TOKENS=5000

# AI autopilot usage guardrails (daily; market reviews are paper-only)
AI_AUTOPILOT_MAX_ANALYSES_PER_DAY=14
AI_AUTOPILOT_DAILY_TOKEN_LIMIT=120000
